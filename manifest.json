{
  "manifest_version": 3,
  "name": "Bookmark Butler",
  "version": "0.2.0",
  "description": "Search and organize bookmarks from a popup, and clean up duplicates, dead links and empty folders.",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "permissions": ["bookmarks", "storage", "alarms", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "omnibox": { "keyword": "b" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extension_name__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
